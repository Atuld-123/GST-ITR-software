# Copy to .env.production and keep it out of source control.
POSTGRES_ADMIN_USER=taxsphere_bootstrap
POSTGRES_ADMIN_PASSWORD=replace-with-unique-random-secret
APP_DB_USER=taxsphere_app
APP_DB_PASSWORD=replace-with-unique-random-secret
MIGRATOR_DB_USER=taxsphere_migrator
MIGRATOR_DB_PASSWORD=replace-with-unique-random-secret
DATABASE_URL=postgresql+asyncpg://taxsphere_app:URL_ENCODED_PASSWORD@db:5432/taxsphere?ssl=require
MIGRATION_DATABASE_URL=postgresql+asyncpg://taxsphere_migrator:URL_ENCODED_PASSWORD@db:5432/taxsphere?ssl=require
JWT_SECRET=replace-with-random-secret-at-least-32-characters
JWT_ISSUER=taxsphere-india
DOCUMENTS_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
FRONTEND_ORIGIN=https://taxsphere.example.com
EDGE_TLS_DIRECTORY=./deploy/tls
POSTGRES_TLS_CERT=./deploy/tls/db-server.crt
POSTGRES_TLS_KEY=./deploy/tls/db-server.key
POSTGRES_VOLUME_NAME=taxsphere-production-data
